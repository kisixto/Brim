<UserControl x:Class="Island.Tabs.TodayTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="14,10">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="MonthText" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock x:Name="DayText" Foreground="White" FontSize="46" FontWeight="Bold" Margin="0,-6,0,-6" />
                <TextBlock x:Name="WeekdayText" Foreground="{StaticResource Muted}" FontSize="12" />
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,4">
                    <TextBox x:Name="NewTodo" Style="{StaticResource DarkTextBox}" Margin="0,0,40,0"
                             KeyDown="NewTodo_KeyDown" TextChanged="NewTodo_TextChanged" />
                    <TextBlock x:Name="Hint" Text="할 일 추가 (Enter)" Foreground="#5A5A5E" FontSize="12"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0" />
                    <TextBlock x:Name="CountText" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="TodoList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="Row" Background="Transparent" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource DarkCheck}" IsChecked="{Binding Done, Mode=TwoWay}"
                                              Click="Check_Click">
                                        <TextBlock x:Name="Label" Text="{Binding Text}" Foreground="White" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                    </CheckBox>
                                    <Button x:Name="Delete" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;"
                                            FontSize="9" Width="22" Height="22" Visibility="Hidden" Click="Delete_Click" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Done}" Value="True">
                                        <Setter TargetName="Label" Property="TextDecorations" Value="Strikethrough" />
                                        <Setter TargetName="Label" Property="Foreground" Value="#6A6A6E" />
                                    </DataTrigger>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Delete" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
