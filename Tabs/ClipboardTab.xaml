<UserControl x:Class="Brim.Tabs.ClipboardTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="2,0,0,6">
            <TextBlock x:Name="Status" Text="{DynamicResource L.ClipHint}" Foreground="{StaticResource Muted}" FontSize="11"
                       VerticalAlignment="Center" />
            <Button Style="{StaticResource TextButton}" Content="{DynamicResource L.ClipClear}" HorizontalAlignment="Right" Click="Clear_Click" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource RowButton}" Click="Item_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Image entries show a thumbnail; text entries hide it. -->
                                <Border x:Name="ThumbFrame" CornerRadius="4" ClipToBounds="True" Margin="0,0,10,0" MaxWidth="120">
                                    <Image Source="{Binding Thumb}" MaxHeight="48" Stretch="Uniform" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Preview}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Time}" Foreground="{StaticResource Muted}"
                                           FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Thumb}" Value="{x:Null}">
                                <Setter TargetName="ThumbFrame" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock x:Name="Empty" Grid.Row="1" Text="{DynamicResource L.ClipEmpty}" Foreground="#5A5A5E" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>
