<UserControl x:Class="Brim.Tabs.ClipboardTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Text / Images switch, a status line, and Clear (clears the view you're on). -->
        <Grid Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Border Background="#262629" CornerRadius="10" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ShowTexts" Style="{StaticResource Segment}" GroupName="clipView" IsChecked="True"
                                     Checked="View_Checked" />
                        <RadioButton x:Name="ShowImages" Style="{StaticResource Segment}" GroupName="clipView"
                                     Checked="View_Checked" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="Status" Text="{DynamicResource L.ClipHint}" Foreground="{StaticResource Muted}" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
            <Button Style="{StaticResource TextButton}" Content="{DynamicResource L.ClipClear}" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Click="Clear_Click" />
        </Grid>

        <!-- Text history -->
        <ScrollViewer x:Name="TextView" Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <ItemsControl x:Name="TextList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource RowButton}" Click="Item_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Preview}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{StaticResource Muted}"
                                           FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Image history: a grid of thumbnails -->
        <ScrollViewer x:Name="ImageView" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
            <ItemsControl x:Name="ImageList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ThumbButton}" Click="Item_Click" ToolTip="{Binding Preview}"
                                Margin="0,0,6,6">
                            <Grid Width="114" Height="72">
                                <Border CornerRadius="8">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Border Background="#B0000000" CornerRadius="5" Padding="5,1" Margin="4"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding Time}" Foreground="White" FontSize="9" />
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="Empty" Grid.Row="1" Foreground="#5A5A5E" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>
