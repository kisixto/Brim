<UserControl x:Class="Island.Tabs.ControlsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Now playing -->
        <Border Style="{StaticResource Card}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="72" Height="72" VerticalAlignment="Center">
                    <Border CornerRadius="10" Background="#2C2C2F">
                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="#5A5A5E"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="ArtFrame" CornerRadius="10">
                        <Border.Background>
                            <ImageBrush x:Name="Art" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SongTitle" Text="재생 중인 음악 없음" Foreground="White" FontSize="13"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SongArtist" Foreground="{StaticResource Muted}" FontSize="11"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="-6,6,0,0">
                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="Prev_Click" />
                        <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="16" Click="Play_Click" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Volume / brightness -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8,10,12,10">
            <StackPanel VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE767;" Click="Mute_Click"
                            ToolTip="음소거" />
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource DarkSlider}" Maximum="100"
                            Margin="6,0" VerticalAlignment="Center" ValueChanged="Volume_Changed" />
                    <TextBlock x:Name="VolumeText" Grid.Column="2" Foreground="{StaticResource Muted}" FontSize="11"
                               VerticalAlignment="Center" TextAlignment="Right" />
                </Grid>
                <Grid x:Name="BrightnessRow" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource DarkSlider}" Maximum="100"
                            Margin="6,0" VerticalAlignment="Center" ValueChanged="Brightness_Changed" />
                    <TextBlock x:Name="BrightnessText" Grid.Column="2" Foreground="{StaticResource Muted}" FontSize="11"
                               VerticalAlignment="Center" TextAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
