<UserControl x:Class="Notchy.Tabs.OptionsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Rows are built in code (see OptionsTab.xaml.cs); the list scrolls once it outgrows the island. -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False"
                  PreviewMouseWheel="Scroller_PreviewMouseWheel">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
        </ScrollViewer.Resources>
        <StackPanel x:Name="Rows" Margin="0,0,10,6" />
    </ScrollViewer>
</UserControl>
