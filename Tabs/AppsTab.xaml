<UserControl x:Class="Notchy.Tabs.AppsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <WrapPanel x:Name="Tiles" HorizontalAlignment="Center" />
        </ScrollViewer>
        <TextBlock x:Name="Hint" Text="{DynamicResource L.AppsHint}"
                   Foreground="#5A5A5E" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
    </Grid>
</UserControl>
