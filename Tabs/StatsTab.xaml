<UserControl x:Class="Brim.Tabs.StatsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- CPU / Memory / Disk / Battery. Clicking CPU or Memory picks the list on the right. -->
        <UniformGrid x:Name="Tiles" Rows="2" Columns="2" Margin="-3" />

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="TopTitle" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold"
                           ToolTip="{DynamicResource L.StatsPick}" />
                <StackPanel x:Name="TopRows" Grid.Row="1" Margin="0,5,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
