<UserControl x:Class="Brim.Tabs.WindowsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Open windows, like taskbar buttons. Built in code. -->
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <WrapPanel x:Name="Tiles" HorizontalAlignment="Center" />
        </ScrollViewer>
        <TextBlock x:Name="Empty" Text="{DynamicResource L.WinEmpty}" Foreground="#5A5A5E" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

        <!-- Shortcuts the taskbar's corners usually give you. -->
        <UniformGrid Grid.Row="1" Rows="1" Margin="-3,6,-3,0">
            <Button Style="{StaticResource PillButton}" Margin="3,0" Click="Desktop_Click" ToolTip="Win+D">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource L.WinDesktop}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource PillButton}" Margin="3,0" Click="TaskView_Click" ToolTip="Win+Tab">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7C4;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource L.WinTaskView}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource PillButton}" Margin="3,0" Click="QuickSettings_Click" ToolTip="Win+A">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource L.WinQuick}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource PillButton}" Margin="3,0" Click="Notifications_Click" ToolTip="Win+N">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7E7;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource L.WinNotify}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </UniformGrid>
    </Grid>
</UserControl>
