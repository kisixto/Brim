<UserControl x:Class="Brim.Tabs.PowerTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <UniformGrid x:Name="Buttons" Rows="1" Height="90" VerticalAlignment="Center" Margin="-4,0">
            <Button Style="{StaticResource CardButton}" Click="Lock_Click">
                <StackPanel>
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" />
                    <TextBlock Text="Lock" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    <Border Height="2" Margin="0,6,0,0" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource CardButton}" Click="Sleep_Click">
                <StackPanel>
                    <TextBlock Text="&#xE708;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" />
                    <TextBlock Text="Sleep" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    <Border Height="2" Margin="0,6,0,0" />
                </StackPanel>
            </Button>
            <Button x:Name="RestartButton" Style="{StaticResource CardButton}" Click="Restart_Click">
                <StackPanel>
                    <TextBlock x:Name="RestartIcon" Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="RestartLabel" Text="Restart" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    <!-- Countdown: shrinks over the 3 seconds the confirmation stays armed. -->
                    <Border x:Name="RestartBar" Height="2" Width="44" CornerRadius="1" Background="White" Opacity="0"
                            Margin="0,6,0,0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform />
                        </Border.RenderTransform>
                    </Border>
                </StackPanel>
            </Button>
            <Button x:Name="ShutdownButton" Style="{StaticResource CardButton}" Click="Shutdown_Click">
                <StackPanel>
                    <TextBlock x:Name="ShutdownIcon" Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="ShutdownLabel" Text="Shut down" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    <Border x:Name="ShutdownBar" Height="2" Width="44" CornerRadius="1" Background="White" Opacity="0"
                            Margin="0,6,0,0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform />
                        </Border.RenderTransform>
                    </Border>
                </StackPanel>
            </Button>
            <Button x:Name="TimerButton" Style="{StaticResource CardButton}" Click="Timer_Click">
                <StackPanel>
                    <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" />
                    <TextBlock Text="Timer" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    <Border Height="2" Margin="0,6,0,0" />
                </StackPanel>
            </Button>
        </UniformGrid>

        <!-- Schedule picker: takes the place of the buttons while open. -->
        <Border x:Name="Picker" Style="{StaticResource Card}" Padding="14,10" Visibility="Collapsed" Opacity="0">
            <StackPanel VerticalAlignment="Center">
                <Grid>
                    <TextBlock Text="{DynamicResource L.SchedAction}" Foreground="{StaticResource Muted}" FontSize="11"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border HorizontalAlignment="Right" Background="#262629" CornerRadius="10" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ActShutdown" Style="{StaticResource Segment}" GroupName="schedAction"
                                         Content="{DynamicResource L.ActShutdown}" IsChecked="True" />
                            <RadioButton x:Name="ActRestart" Style="{StaticResource Segment}" GroupName="schedAction"
                                         Content="{DynamicResource L.ActRestart}" />
                            <RadioButton x:Name="ActSleep" Style="{StaticResource Segment}" GroupName="schedAction"
                                         Content="{DynamicResource L.ActSleep}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <TextBlock Text="{DynamicResource L.SchedAfter}" Foreground="{StaticResource Muted}" FontSize="11"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource PillButton}" Width="64" Margin="0,0,6,0" Tag="15" Click="Preset_Click"
                                Content="{DynamicResource L.Sched15}" />
                        <Button Style="{StaticResource PillButton}" Width="64" Margin="0,0,6,0" Tag="30" Click="Preset_Click"
                                Content="{DynamicResource L.Sched30}" />
                        <Button Style="{StaticResource PillButton}" Width="64" Margin="0,0,6,0" Tag="60" Click="Preset_Click"
                                Content="{DynamicResource L.Sched60}" />
                        <Button Style="{StaticResource PillButton}" Width="64" Tag="120" Click="Preset_Click"
                                Content="{DynamicResource L.Sched120}" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Button Style="{StaticResource TextButton}" Content="{DynamicResource L.SchedBack}" VerticalAlignment="Center"
                            HorizontalAlignment="Left" Click="Back_Click" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="PickerHint" Foreground="#E5534B" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="{DynamicResource L.SchedAt}" Foreground="{StaticResource Muted}" FontSize="11"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Border Background="#262629" CornerRadius="8" Padding="8,3" Width="66">
                            <TextBox x:Name="TimeInput" Style="{StaticResource DarkTextBox}" MaxLength="5"
                                     Typography.NumeralAlignment="Tabular" KeyDown="TimeInput_KeyDown" />
                        </Border>
                        <Button Style="{StaticResource PillButton}" Width="64" Margin="6,0,0,0" Click="SetAt_Click"
                                Content="{DynamicResource L.SchedSet}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Active schedule: live countdown and a way out. -->
        <Grid x:Name="Status" Grid.Row="1" Margin="2,8,2,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="12"
                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                           VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
            </StackPanel>
            <Button x:Name="CancelButton" Style="{StaticResource TextButton}" HorizontalAlignment="Right"
                    Content="{DynamicResource L.SchedCancel}" Click="CancelSchedule_Click" />
        </Grid>
    </Grid>
</UserControl>
