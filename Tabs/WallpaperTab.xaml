<UserControl x:Class="Island.Tabs.WallpaperTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="2,0,0,6">
            <TextBlock x:Name="FolderText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,140,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource TextButton}" Content="무작위" Click="Random_Click" />
                <Button Style="{StaticResource TextButton}" Content="폴더 변경" Margin="6,0,0,0" Click="Folder_Click" />
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="Scroller" Grid.Row="1" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Scroller_PreviewMouseWheel">
            <StackPanel x:Name="Thumbs" Orientation="Horizontal" />
        </ScrollViewer>
        <TextBlock x:Name="Empty" Grid.Row="1" Text="이 폴더에는 사진이 없어요" Foreground="#5A5A5E" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
    </Grid>
</UserControl>
